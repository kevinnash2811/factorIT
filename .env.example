PORT=3000

DB_HOST=
DB_PORT=5432
DB_NAME=bd_cla_prod
DB_USER=
DB_PASSWORD=
DB_LOGGING=false

# Llave compartida del servicio. Si se define, toda petición debe traer la
# cabecera x-api-token con este valor (/health queda abierto para monitoreo).
#
# Es OBLIGATORIA cuando el BFF se publica por un túnel a internet: sin ella la
# URL basta para leer todas las solicitudes. Déjala vacía solo en local.
#
# Generar una así:  [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
API_TOKEN=
