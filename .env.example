PORT=3000

DB_HOST=
DB_PORT=5432
DB_NAME=bd_cla_prod
DB_USER=
DB_PASSWORD=
DB_LOGGING=false

# Llave compartida del servicio. Si se define, toda petición debe traer la
# cabecera x-api-token con este valor (/health queda abierto para monitoreo).
#
# Es OBLIGATORIA cuando el BFF se publica por un túnel a internet: sin ella la
# URL basta para leer todas las solicitudes. Déjala vacía solo en local.
#
# Generar una así:  [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
API_TOKEN=

# Oracle (Menú Andes). Cuentas Contables lee y escribe "OPS$ANDES"."ERP_TRACTA".
# Las tres variables son obligatorias: sin ellas el BFF no arranca.
# El usuario necesita SELECT, INSERT y UPDATE sobre ERP_TRACTA y SELECT sobre la
# secuencia ERP_TCT_SEC. Nunca subir sus valores al repositorio.
ORACLE_USER=
ORACLE_PASSWORD=
# Descriptor completo (DESCRIPTION=...) o host:puerto/servicio
ORACLE_CONNECT_STRING=

# --- Adjuntar desde Google Drive (opcional) ---
# Sin estas dos, el botón queda deshabilitado y la pantalla lo explica;
# el resto del sistema funciona igual. Las crea quien administre Google
# Cloud de la organización, con la pantalla de consentimiento en modo
# Interno y el permiso acotado drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
# Origen del portal, para que la ventana del selector solo le devuelva
# el resultado a la aplicación y no a cualquier sitio.
RETOOL_ORIGEN=
