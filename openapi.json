{"openapi":"3.0.0","paths":{"/solicitudes":{"get":{"description":"Lista paginada de solicitudes con SLA, estado y acciones ya resueltos por el servidor. El front sólo pinta.","operationId":"SolicitudesController_listar","parameters":[{"name":"estado","required":false,"in":"query","schema":{"type":"string","enum":["PENDIENTE_APROBACION","APROBADO_CONTABILIZAR","EN_REPARO","INTEGRADO_SAP","ERROR_SAP","RECHAZADO_CERRADO"]}},{"name":"sociedad","required":false,"in":"query","schema":{"type":"string","enum":["1000","6000","8000"]}},{"name":"ruta","required":false,"in":"query","schema":{"example":"R10","type":"string"}},{"name":"q","required":false,"in":"query","description":"Busca por ID, solicitante, factura o CECO","schema":{"example":"TKT-82","type":"string"}},{"name":"fechaDesde","required":false,"in":"query","description":"Filtra creadoEn >= esta fecha (inclusive).","schema":{"example":"2026-08-01","type":"string"}},{"name":"fechaHasta","required":false,"in":"query","description":"Filtra creadoEn <= el final de este día (inclusive).","schema":{"example":"2026-08-31","type":"string"}},{"name":"montoMin","required":false,"in":"query","schema":{"example":50000,"type":"number"}},{"name":"montoMax","required":false,"in":"query","schema":{"example":5000000,"type":"number"}},{"name":"slaEstado","required":false,"in":"query","description":"CUMPLE: integrado a SAP, o activo dentro de plazo. NO_CUMPLE: activo y con el plazo de 2 días hábiles ya vencido.","schema":{"type":"string","enum":["CUMPLE","NO_CUMPLE"]}},{"name":"page","required":false,"in":"query","schema":{"minimum":1,"default":1,"type":"number"}},{"name":"size","required":false,"in":"query","schema":{"minimum":1,"maximum":100,"default":20,"type":"number"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SolicitudesPaginadasDto"}}}}},"summary":"Bandeja Contable","tags":["Solicitudes"]},"post":{"description":"Crea la cabecera, las líneas de ajuste (si aplica R23) y los dos primeros pasos de bitácora en una sola transacción.","operationId":"SolicitudesController_crear","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CrearSolicitudDto"}}}},"responses":{"201":{"description":"Solicitud creada"},"400":{"description":"Ruta inválida, ajuste descuadrado, o error de validación","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}},"409":{"description":"Gasto duplicado (misma factura y monto)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Ingresar Solicitud","tags":["Solicitudes"]}},"/solicitudes/exportar":{"get":{"description":"Genera un .xlsx con TODAS las solicitudes que cumplen los mismos filtros de la Bandeja (hasta un tope de 10.000 filas), no solo la página visible. Enmascara confidenciales igual que el listado — el archivo nunca expone más de lo que el usuario ve en pantalla.","operationId":"SolicitudesController_exportar","parameters":[{"name":"estado","required":false,"in":"query","schema":{"type":"string","enum":["PENDIENTE_APROBACION","APROBADO_CONTABILIZAR","EN_REPARO","INTEGRADO_SAP","ERROR_SAP","RECHAZADO_CERRADO"]}},{"name":"sociedad","required":false,"in":"query","schema":{"type":"string","enum":["1000","6000","8000"]}},{"name":"ruta","required":false,"in":"query","schema":{"example":"R10","type":"string"}},{"name":"q","required":false,"in":"query","description":"Busca por ID, solicitante, factura o CECO","schema":{"example":"TKT-82","type":"string"}},{"name":"fechaDesde","required":false,"in":"query","description":"Filtra creadoEn >= esta fecha (inclusive).","schema":{"example":"2026-08-01","type":"string"}},{"name":"fechaHasta","required":false,"in":"query","description":"Filtra creadoEn <= el final de este día (inclusive).","schema":{"example":"2026-08-31","type":"string"}},{"name":"montoMin","required":false,"in":"query","schema":{"example":50000,"type":"number"}},{"name":"montoMax","required":false,"in":"query","schema":{"example":5000000,"type":"number"}},{"name":"slaEstado","required":false,"in":"query","description":"CUMPLE: integrado a SAP, o activo dentro de plazo. NO_CUMPLE: activo y con el plazo de 2 días hábiles ya vencido.","schema":{"type":"string","enum":["CUMPLE","NO_CUMPLE"]}},{"name":"page","required":false,"in":"query","schema":{"minimum":1,"default":1,"type":"number"}},{"name":"size","required":false,"in":"query","schema":{"minimum":1,"maximum":100,"default":20,"type":"number"}}],"responses":{"200":{"description":""}},"summary":"Exportar solicitudes a Excel","tags":["Solicitudes"]}},"/solicitudes/{id}/aprobar":{"patch":{"description":"PENDIENTE_APROBACION -> APROBADO_CONTABILIZAR. Agrega el paso a la bitácora en la misma transacción.","operationId":"SolicitudesController_aprobar","parameters":[{"name":"id","required":true,"in":"path","schema":{"example":"TKT-4122","type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AprobarSolicitudDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AccionSolicitudResultadoDto"}}}},"404":{"description":"Solicitud no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}},"409":{"description":"La solicitud no está en estado PENDIENTE_APROBACION","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Dar Visto Bueno (VB)","tags":["Solicitudes"]}},"/solicitudes/{id}/contabilizar":{"patch":{"description":"APROBADO_CONTABILIZAR -> INTEGRADO_SAP. Genera un voucher contable y agrega el paso a la bitácora.","operationId":"SolicitudesController_contabilizar","parameters":[{"name":"id","required":true,"in":"path","schema":{"example":"TKT-4122","type":"string"}},{"name":"idempotency-key","required":true,"in":"header","schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","description":"Evita duplicar el voucher si Retool reintenta la llamada","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContabilizarSolicitudResultadoDto"}}}},"404":{"description":"Solicitud no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}},"409":{"description":"La solicitud no está en estado APROBADO_CONTABILIZAR","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Integrar a SAP HANA","tags":["Solicitudes"]}},"/solicitudes/{id}":{"get":{"description":"Colaborador, información financiera, destino de pago, descripción, documento e historial completo, para el modal \"DETALLE INTEGRAL DE SOLICITUD\".","operationId":"SolicitudesController_detalle","parameters":[{"name":"id","required":true,"in":"path","schema":{"example":"TKT-4122","type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SolicitudDetalleDto"}}}},"404":{"description":"Solicitud no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Detalle integral de la solicitud","tags":["Solicitudes"]}},"/solicitudes/{id}/bitacora":{"get":{"description":"Línea de tiempo del flujo (bitacora_auditoria) más el respaldo documental adjuntado al crear la solicitud.","operationId":"SolicitudesController_bitacora","parameters":[{"name":"id","required":true,"in":"path","schema":{"example":"FNZ-130309","type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BitacoraSolicitudDto"}}}},"404":{"description":"Solicitud no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Bitácora del caso","tags":["Solicitudes"]}},"/catalogos":{"get":{"operationId":"CatalogosController_obtener","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CatalogosDto"}}}}},"summary":"Rutas, CECOs y medios de pago para el formulario de Ingresar Solicitud","tags":["Catálogos"]}},"/indicadores/bandeja":{"get":{"description":"Conteo en vivo por grupo de estado. No es un dato cacheado ni histórico — cada llamada recalcula contra la base actual.","operationId":"IndicadoresController_bandeja","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IndicadoresBandejaDto"}}}}},"summary":"Los 4 KPIs de la cabecera de la Bandeja Contable","tags":["Indicadores"]}},"/indicadores/alertas-sla":{"get":{"description":"Todos los tickets activos con SLA vencido o por vencer, sin filtros ni paginación — a propósito independiente de lo que esté filtrado en la Bandeja.","operationId":"IndicadoresController_alertasSla","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AlertasSlaDto"}}}}},"summary":"Panel de Alertas Críticas SLA (sidebar derecho de la Bandeja)","tags":["Indicadores"]}},"/indicadores/eficiencia-cierres":{"get":{"description":"Reemplaza el gráfico de ejemplo del mock (East/West/South/Central) por una métrica real: cumplimiento de SLA de los tickets ya integrados a SAP, agrupados por gerencia.","operationId":"IndicadoresController_eficienciaCierres","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EficienciaCierresDto"}}}}},"summary":"Tickets cerrados a tiempo vs. vencidos, por gerencia","tags":["Indicadores"]}},"/indicadores/presupuesto-ceco":{"get":{"description":"Presupuesto total, gastado, saldo y % de consumo por gerencia. El gasto acumulado se mantiene al día automáticamente por un trigger de Postgres cada vez que una solicitud se aprueba o se integra a SAP — este endpoint solo resuelve la presentación (saldo, %, color de semáforo).","operationId":"IndicadoresController_presupuestoPorCeco","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PresupuestoCecoDto"}}}}},"summary":"Presupuesto CLA por Centro de Costo","tags":["Indicadores"]}},"/indicadores/gastos-por-mes":{"get":{"description":"Cantidad de solicitudes y monto total ingresado por mes, últimos 12 meses. Primer reporte del módulo \"Reportes\" — se usa la misma base transaccional mientras se define la vía BigQuery/Looker Studio.","operationId":"IndicadoresController_gastosPorMes","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GastosPorMesDto"}}}}},"summary":"Reporte: Gastos por Mes","tags":["Indicadores"]}},"/indicadores/solicitudes-por-estado":{"get":{"description":"Composición actual de la cartera por los 6 estados reales (no los 4 grupos de KPIs de la Bandeja). Misma etiqueta y color que ve el analista en la tabla.","operationId":"IndicadoresController_solicitudesPorEstado","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SolicitudesPorEstadoDto"}}}}},"summary":"Reporte: Solicitudes por Estado","tags":["Indicadores"]}},"/documentos":{"post":{"description":"Almacenamiento provisional en disco del servidor. Reemplazar por WCC cuando haya acceso. Campo multipart esperado: \"files\" (puede repetirse varias veces en el mismo form-data).","operationId":"DocumentosController_subir","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentosSubidosDto"}}}}},"summary":"Sube uno o varios respaldos (factura, boleta, Word, Excel) — hasta 5 por solicitud","tags":["Documentos"]}},"/rutas":{"get":{"description":"Listado completo de rutas contables (sociedad, clase de documento, confidencialidad) para la pantalla de administración \"Matriz de Reglas\".","operationId":"RutasController_listar","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RutaDetalleDto"}}}}}},"summary":"Matriz de Rutas de Pago","tags":["Rutas"]},"post":{"description":"Da de alta una nueva ruta en la matriz de reglas. Editar/eliminar quedan pendientes de definir permisos por rol.","operationId":"RutasController_crear","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CrearRutaDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RutaDetalleDto"}}}},"400":{"description":"Datos inválidos","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}},"409":{"description":"Ya existe una ruta con ese ID","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Crear ruta contable","tags":["Rutas"]}},"/rutas/{id}":{"patch":{"description":"Modifica nombre, sociedad, clase de documento y confidencialidad de una ruta existente. El ID no se puede cambiar.","operationId":"RutasController_actualizar","parameters":[{"name":"id","required":true,"in":"path","schema":{"example":"R23","type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActualizarRutaDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RutaDetalleDto"}}}},"400":{"description":"Datos inválidos","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}},"404":{"description":"Ruta no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Actualizar ruta contable","tags":["Rutas"]},"delete":{"description":"No borra la fila (rompería el historial de solicitudes que ya la usaron) — la marca como inactiva. Sigue apareciendo en la Matriz de Reglas (bloqueada), pero deja de ofrecerse en el selector de \"Nueva Solicitud\".","operationId":"RutasController_eliminar","parameters":[{"name":"id","required":true,"in":"path","schema":{"example":"R23","type":"string"}}],"responses":{"204":{"description":""},"404":{"description":"Ruta no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Dar de baja una ruta contable","tags":["Rutas"]}},"/rutas/{id}/reactivar":{"patch":{"description":"Vuelve a marcarla activa — vuelve a ofrecerse en el selector de \"Nueva Solicitud\".","operationId":"RutasController_reactivar","parameters":[{"name":"id","required":true,"in":"path","schema":{"example":"R23","type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RutaDetalleDto"}}}},"404":{"description":"Ruta no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Reactivar una ruta contable dada de baja","tags":["Rutas"]}},"/cuentas-tracta":{"get":{"description":"Motor de reglas auxiliares de finanzas — cómo se asientan, distribuyen montos y asocian cuentas de control en el ERP SAP.","operationId":"CuentasTractaController_listar","parameters":[{"name":"sociedad","required":false,"in":"query","schema":{"example":"1000","type":"string"}},{"name":"sistema","required":false,"in":"query","schema":{"example":"ACT","type":"string"}},{"name":"q","required":false,"in":"query","description":"Busca en Glosa, Transacción, Cuenta Mayor, Auxiliar o Centro de Costo","schema":{"example":"ARRIENDO","type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CuentasTractaListadoDto"}}}}},"summary":"Parametrización de Cuentas Contables (Oracle ERP_TRACTA)","tags":["Cuentas TRACTA"]},"post":{"description":"Da de alta una nueva regla de asiento auxiliar Oracle → cuenta de control SAP. El resto de metadatos Oracle (Debe/Haber, agrupación, sucursal de agrupación) los aplica la base de datos con sus valores por defecto — mismo criterio que \"Metadatos Oracle Sincronizados\" del mock.","operationId":"CuentasTractaController_crear","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CrearCuentaTractaDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CuentaTractaItemDto"}}}},"400":{"description":"Datos inválidos","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Parametrizar nueva cuenta TRACTA","tags":["Cuentas TRACTA"]}},"/cuentas-tracta/{sec}":{"patch":{"description":"Modifica los datos de una regla de asiento auxiliar existente. La secuencia (SEC) no se puede cambiar.","operationId":"CuentasTractaController_actualizar","parameters":[{"name":"sec","required":true,"in":"path","schema":{"example":1,"type":"number"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActualizarCuentaTractaDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CuentaTractaItemDto"}}}},"400":{"description":"Datos inválidos","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}},"404":{"description":"Cuenta TRACTA no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Actualizar cuenta TRACTA","tags":["Cuentas TRACTA"]},"delete":{"description":"No borra la fila (rompería la trazabilidad de transacciones ya asentadas con esta regla) — la marca como inactiva (tct_estado = \"I\"). Sigue apareciendo en el listado (bloqueada), con opción de reactivar.","operationId":"CuentasTractaController_eliminar","parameters":[{"name":"sec","required":true,"in":"path","schema":{"example":1,"type":"number"}}],"responses":{"204":{"description":""},"404":{"description":"Cuenta TRACTA no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Dar de baja una cuenta TRACTA","tags":["Cuentas TRACTA"]}},"/cuentas-tracta/{sec}/reactivar":{"patch":{"description":"Vuelve a marcarla activa (tct_estado = \"A\").","operationId":"CuentasTractaController_reactivar","parameters":[{"name":"sec","required":true,"in":"path","schema":{"example":1,"type":"number"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CuentaTractaItemDto"}}}},"404":{"description":"Cuenta TRACTA no encontrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponseDto"}}}}},"summary":"Reactivar una cuenta TRACTA dada de baja","tags":["Cuentas TRACTA"]}},"/preferencias":{"get":{"description":"Devuelve las columnas que el usuario decidió ocultar. Se guarda en la base (no en el navegador) para que la configuración lo siga aunque entre desde otro equipo. Si nunca guardó nada, devuelve una lista vacía — equivale a \"mostrar todas las columnas\".","operationId":"PreferenciasController_obtener","parameters":[{"name":"usuario","required":true,"in":"query","schema":{"example":"kevin.torrez@cajalosandes.cl","type":"string"}},{"name":"pantalla","required":true,"in":"query","description":"Identificador de la pantalla (reportes, bandeja, ...).","schema":{"example":"reportes","type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreferenciaDto"}}}}},"summary":"Preferencias de interfaz del usuario para una pantalla","tags":["Preferencias"]},"put":{"description":"Reemplaza la configuración de esa pantalla para ese usuario (upsert).","operationId":"PreferenciasController_guardar","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GuardarPreferenciaDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreferenciaDto"}}}}},"summary":"Guardar las preferencias de interfaz del usuario","tags":["Preferencias"]}}},"info":{"title":"BFF Workflow de Solicitudes — CLA","description":"API para el Portal de Gestión Contable en Retool. Cubre por ahora Bandeja Contable e Ingresar Solicitud; el resto de las pantallas se agrega según avance el port.","version":"0.1.0","contact":{}},"tags":[{"name":"Solicitudes","description":""},{"name":"Catálogos","description":""},{"name":"Indicadores","description":""},{"name":"Documentos","description":""}],"servers":[],"components":{"schemas":{"SolicitanteDto":{"type":"object","properties":{"nombre":{"type":"string","example":"Marcelo Silva"},"email":{"type":"string","example":"marcelo.silva@cajalosandes.cl"},"iniciales":{"type":"string","example":"MS"},"cargo":{"type":"object","example":"Analista Contable","nullable":true},"gerencia":{"type":"object","example":"Subgerencia de Contabilidad","nullable":true,"description":"Gerencia declarada por quien ingresa la solicitud."}},"required":["nombre","email","iniciales","cargo","gerencia"]},"MontoDto":{"type":"object","properties":{"valor":{"type":"object","example":125000,"nullable":true,"description":"null si el ticket está enmascarado por confidencialidad"},"moneda":{"type":"string","example":"CLP"},"formateado":{"type":"string","example":"$125.000"}},"required":["valor","moneda","formateado"]},"RutaDto":{"type":"object","properties":{"id":{"type":"string","example":"R10"},"nombre":{"type":"string","example":"Gasto Operacional (Todas las áreas)"}},"required":["id","nombre"]},"CecoDto":{"type":"object","properties":{"id":{"type":"string","example":"CEBE0099"},"gerencia":{"type":"string","example":"Gerencia de Beneficios Sociales",